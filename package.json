{
  "name": "react-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "prettier --write -l . && eslint --quiet --fix .",
    "build": "next build",
    "start": "next start",
    "dev": "next dev",
    "test": "jest"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120,
    "arrowParens": "avoid",
    "experimentalOperatorPosition": "start",
    "bracketSameLine": true
  },
  "overrides": {
    "@astryxdesign/core": {
      "@stylexjs/stylex": "$@stylexjs/stylex"
    }
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.6",
    "@astryxdesign/theme-neutral": "^0.1.6",
    "@stylexjs/stylex": "^0.19.0",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.7.0",
    "requestidlecallback-polyfill": "^1.0.2"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.6",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
